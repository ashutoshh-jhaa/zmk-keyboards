#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

/ {
    combos {
        compatible = "zmk,combos";

        combo_studio_unlock {
            timeout-ms = <50>;
            key-positions = <0 1>;
            bindings = <&studio_unlock>;
        };
    };

    behaviors {
        z_gui: z_gui {
            compatible = "zmk,behavior-hold-tap";
            label = "Z_GUI";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <150>;
            flavor = "tap-preferred";
        };

        f_nav: f_nav {
            compatible = "zmk,behavior-hold-tap";
            label = "F_NAV";
            bindings = <&mo>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <150>;
            flavor = "tap-preferred";
        };
    };

    keymap {
        compatible = "zmk,keymap";

        base {
            display-name = "base";
            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp C_VOL_UP C_VOL_DN>;

            // -----------------------------------------------------------------------------------------
            // |  TAB |  Q  |  W  |  E  |  R  |  T  |   |  Y  |  U   |  I  |  O  |  P  | BSPC |
            // | CTRL |  A  |  S  |  D  |  F  |  G  |   |  H  |  J   |  K  |  L  |  ;  |  '   |
            // | SHFT |  Z  |  X  |  C  |  V  |  B  |   |  N  |  M   |  ,  |  .  |  /  | ESC  |
            //                    | GUI | LWR | SPC |   | ENT | RSE  | ALT |

            bindings = <
&kp TAB           &kp Q              &kp W  &kp E         &kp R       &kp T    &kp Y         &kp U        &kp I             &kp O    &kp P     &kp BSPC
&kp LEFT_SHIFT    &kp A              &kp S  &kp D         &f_nav 1 F  &kp G    &kp H         &kp J        &kp K             &kp L    &kp SEMI  &kp SQT
&kp LEFT_CONTROL  &z_gui LEFT_GUI Z  &kp X  &kp C         &kp V       &kp B    &kp N         &kp M        &kp COMMA         &kp DOT  &kp FSLH  &mo 4
                                            &kp LEFT_ALT  &kp SPACE   &mo 3    &lt 2 ESCAPE  &lt 1 ENTER  &kp LEFT_CONTROL
            >;
        };

        nav {
            bindings = <
&trans  &trans  &trans  &trans  &trans      &kp C_BRIGHTNESS_INC    &trans    &trans    &trans    &trans     &caps_word         &kp DEL
&trans  &trans  &trans  &trans  &trans      &kp C_BRIGHTNESS_DEC    &kp LEFT  &kp DOWN  &kp UP    &kp RIGHT  &kp PRINTSCREEN    &kp C_VOLUME_UP
&trans  &trans  &trans  &trans  &kp K_MUTE  &kp CAPSLOCK            &trans    &trans    &kp HOME  &kp END    &kp K_APPLICATION  &kp C_VOL_DN
                        &trans  &trans      &trans                  &trans    &trans    &trans
            >;
        };

        sym {
            bindings = <
&trans  &kp N1  &kp N2  &kp N3  &kp N4  &kp N5    &kp LS(AMPS)   &kp LS(STAR)   &kp LS(LPAR)  &kp LS(RPAR)  &kp GRAVE     &kp BSPC
&trans  &trans  &trans  &trans  &trans  &trans    &kp EQUAL      &kp MINUS      &kp LBKT      &kp RBKT      &kp LS(PLUS)  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &kp LS(CARET)  &kp LS(UNDER)  &kp LS(LBRC)  &kp LS(RBRC)  &kp BSLH      &trans
                        &trans  &trans  &trans    &trans         &trans         &trans
            >;
        };

        num {
            bindings = <
&trans  &kp N1        &kp N2        &kp N3        &kp N4        &kp N5    &kp N6  &kp N7  &kp N8  &kp N9  &kp N0   &kp BSPC
&trans  &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &trans    &trans  &kp N4  &kp N5  &kp N6  &kp DOT  &trans
&trans  &bt BT_CLR    &trans        &trans        &trans        &trans    &trans  &kp N1  &kp N2  &kp N3  &trans   &trans
                                    &trans        &trans        &trans    &trans  &trans  &trans
            >;
        };

        mouse {
            bindings = <
&trans  &trans          &mmv MOVE_UP    &trans           &mkp MB1  &trans    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &mmv MOVE_LEFT  &mmv MOVE_DOWN  &mmv MOVE_RIGHT  &mkp MB2  &trans    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans          &trans          &trans           &trans    &trans    &trans  &trans  &trans  &trans  &trans  &trans
                                        &trans           &trans    &trans    &trans  &trans  &trans
            >;
        };
    };
};
